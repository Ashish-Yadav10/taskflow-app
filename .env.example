# TaskFlow Environment Configuration

# Database (Leave empty to use SQLite, or provide PostgreSQL URL for production)
DATABASE_URL=

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Environment (development, staging, production)
ENVIRONMENT=production

# Frontend URL (for CORS)
FRONTEND_URL=https://ashish-yadav10.github.io/taskflow-app
BACKEND_URL=https://your-render-url.onrender.com

# Render Web Service URL (will be set automatically by Render)
RENDER_EXTERNAL_URL=
